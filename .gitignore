# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fetch/render dumps (lidar.npz is 270 MB). Re-run `npm run map:fetch` if missing.
# AI teacher tiles, LoRA pairs, and the two full-campus PNGs ARE tracked.
/data/*
!/data/ai/
!/data/ai/**
/data/ai/massing.v
!/data/build/
/data/build/*
!/data/build/final.png
!/data/build/scene.json
/pipeline/.venv/
__pycache__/
/render/out/
/render/dist/
